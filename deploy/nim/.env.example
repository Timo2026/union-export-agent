# deploy/nim/.env.example — NIM 起服环境变量模板 (复制为 .env 后填值; .env 已 gitignore)
# 用法: docker compose --env-file .env up -d   (在 deploy/nim/ 下)
# 探活: python services/nim_smoke.py           (无 NIM 时显式 skip, 不阻断)

# NGC API key: https://build.nvidia.com 获取后粘贴 (真值永不入库)
NGC_API_KEY=paste-your-ngc-api-key-here

# 本地模型缓存目录 (首次拉取数十 GB, 需 NVIDIA GPU + nvidia-container-toolkit)
MODEL_STORE=./nim-cache

# 镜像可换 (FAST/REASON/VISION/ASR/EMBED 各一); 默认值同 docker-compose
# v3 (2026-09-20): 对齐 hf-mirror 实测仓库; NIM 镜像 tag 以 NGC 实际可用为准
NIM_NANO_4B_IMAGE=nvcr.io/nim/nvidia/nemotron-3-nano-4b:latest
NIM_LIGHTNING_IMAGE=nvcr.io/nim/nvidia/nemotron-3.5-lightning-30b-a3b:latest
NIM_OMNI_IMAGE=nvcr.io/nim/nvidia/nemotron-3-nano-omni:latest
NIM_ASR_IMAGE=nvcr.io/nim/nvidia/nemotron-3.5-asr-streaming-0.6b:latest
NIM_EMBED_IMAGE=nvcr.io/nim/nvidia/nemotron-3-embed-1b-bf16:latest
